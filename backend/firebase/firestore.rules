rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user belongs to accountId if their /users/{uid} doc says so.
    // Uses get() — one extra read per rule evaluation, cached within a request.
    function isMember(accountId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountId == accountId;
    }

    // Allowlist document. Users can read their own to resolve their accountId.
    // Write is admin-only — allowlist management is out of scope for the app.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Account document itself — readable by members (needed by getAccount()).
    match /accounts/{accountId} {
      allow read: if isMember(accountId);
      // Account members can update aiConfig via updateAiConfig / toggleAiAutoAdd.
      // Admin creates the account doc.
      allow update: if isMember(accountId);
      allow create, delete: if false;

      // Shared roster of account members — readable by all account members.
      match /users/{userId} {
        allow read, write: if isMember(accountId);
      }

      match /categories/{categoryId} {
        allow read, write: if isMember(accountId);
      }

      match /items/{itemId} {
        allow read, write: if isMember(accountId);
        // Hard-deletion prevention is enforced at the service layer, not here.
      }

      match /shops/{shopId} {
        allow read, write: if isMember(accountId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isMember(accountId);
      }
    }
  }
}
