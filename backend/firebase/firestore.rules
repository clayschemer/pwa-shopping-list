rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user belongs to accountId if their /users/{uid} doc says so
    // AND the doc is not explicitly unverified. Legacy docs without the
    // `verified` field are treated as verified (default true, no migration).
    function isMember(accountId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountId == accountId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verified', true) == true;
    }

    // Allowlist document.
    // - Read: users read their own doc to resolve accountId / verified status.
    // - Create: a signed-in user may create their OWN pending doc with
    //   verified:false and no accountId, carrying only the fields
    //   the client is allowed to set. Admin then flips verified and sets
    //   accountId via the Firebase console.
    // - Update/Delete: admin-only.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.verified == false
        && !('accountId' in request.resource.data)
        && request.resource.data.keys().hasOnly(['verified', 'email', 'displayName', 'createdAt']);
      allow update, delete: if false;
    }

    // Account document itself — readable by members (needed by getAccount()).
    match /accounts/{accountId} {
      allow read: if isMember(accountId);
      // Account members can update aiConfig via updateAiConfig / toggleAiAutoAdd.
      // Admin creates the account doc.
      allow update: if isMember(accountId);
      allow create, delete: if false;

      // Shared roster of account members — readable by all account members.
      match /users/{userId} {
        allow read, write: if isMember(accountId);
      }

      match /categories/{categoryId} {
        allow read, write: if isMember(accountId);
      }

      match /items/{itemId} {
        allow read, write: if isMember(accountId);
        // Hard-deletion prevention is enforced at the service layer, not here.
      }

      match /shops/{shopId} {
        allow read, write: if isMember(accountId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isMember(accountId);
      }

      // Append-only price-feedback corpus for future model-training analysis.
      // Members may read and create entries; updates and deletes are not
      // permitted (the log is immutable by design).
      match /priceFeedback/{entryId} {
        allow read, create: if isMember(accountId);
        allow update, delete: if false;
      }

      // Transient price-lookup queue. The Angular client writes entries when
      // items are added or stale prices are detected; the pipeline reads and
      // deletes them. Members may read and write; the pipeline uses a service
      // account which bypasses these rules entirely.
      match /price-queue/{itemId} {
        allow read, write: if isMember(accountId);
      }
    }
  }
}
