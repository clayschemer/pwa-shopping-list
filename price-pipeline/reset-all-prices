#!/bin/bash
set -e

if [ ! -f service-account.json ]; then
  echo "Error: service-account.json not found."
  exit 1
fi

cat <<EOF
This will set priceUpdatedAt = null on EVERY item in EVERY account.
priceAttemptedAt is cleared too, so the unpriced scan picks items up
on the next cycle. Existing price values are NOT touched.

EOF

read -p "Continue? [y/N] " confirm
if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
  echo "Aborted."
  exit 0
fi

docker compose -f docker-compose.yml -f docker-compose.scheduler.yml run --rm price-fetcher \
  npx tsx src/index.ts --mode reset-all
